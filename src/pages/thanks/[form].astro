---
import Base from '../../layouts/Base.astro';
import { forms, site, type FormKey } from '../../data/site';

export function getStaticPaths() {
  return (Object.keys(forms) as FormKey[]).map((form) => ({ params: { form } }));
}
const key = Astro.params.form as FormKey;
const meta = forms[key];
---
<Base title="Thank you" description="Your information was sent to Floyd Homes and Land." noindex>
  <section class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Sent</p>
      <h1>Thank you.</h1>
      <p class="lede">{meta.thanks}</p>
      <p>Need Dustin sooner? Call or text <a href={`tel:${site.phone.tel}`} class="phone-plain">{site.phone.display}</a>.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/who-we-are/">Read Dustin's story</a>
        <a class="btn btn--ghost" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Base>
