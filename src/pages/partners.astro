---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import hhColor from '../assets/brand/hh-logo-color.png';
import { site } from '../data/site';
---
<Base title="Partners" description="The brokerage, partners and affiliates Floyd Homes and Land works with.">
  <PageHeader eyebrow="Partners" title="Who we work with." lede="The brokerage, partners and affiliates behind Floyd Homes and Land." plat={false} />
  <section class="section">
    <div class="wrap">
      <ul class="ledger">
        <li class="partner">
          <Image src={hhColor} alt="" width={96} height={97} />
          <div><h2 class="h3">{site.brokerage.name}</h2><p class="muted">Our brokerage. FHL sales are powered by Howard Hanna.</p></div>
        </li>
      </ul>
      <p class="todo more">[[TODO: Dustin to confirm which partners and affiliates to list publicly (contractors, OS, Just Ingredients, others), with logos and permission]]</p>
    </div>
  </section>
</Base>
<style>
  .partner { display: grid; grid-template-columns: 96px 1fr; gap: 24px; align-items: center; padding: 24px 0; }
  .h3 { font-size: 1.45rem; margin-bottom: 4px; }
  .more { margin-top: 24px; }
</style>
