---
// One landing page per campaign in src/data/campaigns.ts. The form posts to the same
// Airtable website-form automation as the rest of the site, tagged with the campaign slug.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import IntakeForm from '../../components/IntakeForm.astro';
import Field from '../../components/Field.astro';
import Choices from '../../components/Choices.astro';
import { activeCampaigns, type Campaign } from '../../data/campaigns';
import { site } from '../../data/site';

export function getStaticPaths() {
  return activeCampaigns.map((campaign) => ({ params: { campaign: campaign.slug }, props: { campaign } }));
}

const { campaign } = Astro.props as { campaign: Campaign };
const c = campaign;
const timelineOptions = ['As soon as possible', 'In the next 3 months', 'In the next year', 'Just exploring'];
---
<Base title={c.headline} description={c.description} noindex={c.noindex !== false}>
  <PageHeader eyebrow={c.eyebrow} title={c.headline} lede={c.audience}>
    <div class="btn-row">
      <a class="btn btn--primary" href="#form">Tell us about it</a>
      <a class="btn btn--ghost" href={`tel:${site.phone.tel}`}>Call {site.phone.display}</a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="wrap grid-2">
      <div class="prose">
        {c.offer.map((p) => <p>{p}</p>)}
        {c.points && c.points.length > 0 && (
          <ul class="fit-list">{c.points.map((pt) => <li>{pt}</li>)}</ul>
        )}
      </div>
      <div class="prose">
        <h2 class="h3">Who is Floyd Homes and Land?</h2>
        <p>
          We sell homes and land across Southeastern Virginia, Northeastern North Carolina and the Outer Banks.
          Our sales are powered by {site.brokerage.name}, and Dustin Floyd owns the company.
        </p>
        <p><a class="text-link" href="/who-we-are/">Read Dustin's story</a></p>
      </div>
    </div>
  </section>

  <section class="section form-section" id="form">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">Start the conversation</p>
        <h2>Fill in what you know.</h2>
        <p class="muted">Leave the rest blank. It goes straight to Dustin.</p>
        <p>Prefer to talk? Call or text <span class="phone-plain">{site.phone.display}</span>.</p>
      </div>

      {c.form === 'sell-direct' && (
        <IntakeForm formKey="sell-direct" campaign={c.slug} title={c.formTitle ?? 'Your property'} submitLabel={c.submitLabel ?? 'Send my property to Dustin'} consentTopic="my property">
          <Field label="Property address" name="property_address" required autocomplete="street-address" error="Enter the property address, or the road and county if there is no address." hint="No address yet? The road and county is fine." />
          <Choices legend="What is it?" name="property_type" options={['Land', 'Home', 'Home with land', 'Other']} detail="Property type" />
          <Field label="Rough acreage" name="acreage" detail="Acreage" />
          <Field label="Price you have in mind" name="asking_price" />
          <Choices legend="When would you like to sell?" name="timeline" options={timelineOptions} />
          <Field label="Anything else we should know?" name="remarks" multiline />
        </IntakeForm>
      )}

      {c.form === 'buy-sell' && (
        <IntakeForm formKey="buy-sell" campaign={c.slug} title={c.formTitle ?? 'Tell us what you need'} submitLabel={c.submitLabel} consentTopic="buying or selling real estate">
          <Choices legend="I want to" name="interest" options={['Buy', 'Sell', 'Buy and sell']} required />
          <Choices legend="Type of property" name="property_type" options={['Home', 'Land', 'Home with land', 'Not sure yet']} detail="Property type" />
          <Field label="Address of the property you're selling" name="property_address" autocomplete="street-address" hint="Only if you're selling." />
          <Field label="Price or budget you have in mind" name="asking_price" />
          <Choices legend="Timeline" name="timeline" options={timelineOptions} />
          <Field label="Anything else we should know?" name="remarks" multiline />
        </IntakeForm>
      )}

      {c.form === 'partner' && (
        <IntakeForm formKey="partner" campaign={c.slug} title={c.formTitle ?? 'Tell us about the project'} submitLabel={c.submitLabel} consentTopic="a joint venture or development partnership">
          <Field label="Property address or area" name="property_address" />
          <Field label="What do you have in mind?" name="remarks" multiline />
        </IntakeForm>
      )}

      {c.form === 'contact' && (
        <IntakeForm formKey="contact" campaign={c.slug} title={c.formTitle ?? 'Send Dustin a note'} submitLabel={c.submitLabel} consentTopic="my message">
          <Field label="Your message" name="remarks" multiline />
        </IntakeForm>
      )}
    </div>
  </section>
</Base>

<style>
  .h3 { font-size: clamp(1.3rem, 2.4vw, 1.6rem); }
  .form-section h2 { max-width: 14ch; }
</style>
