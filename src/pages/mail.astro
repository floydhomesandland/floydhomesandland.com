---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---
<Base title="Got Mail From Us?" description="Got a letter from Floyd Homes and Land? Here's who sent it, why, and what to do next.">
  <PageHeader eyebrow="Got mail from us?" title="It was from Dustin Floyd." lede="Floyd Homes and Land sends letters to property owners in the areas we work. If one reached you, we're interested in your property." />
  <section class="section">
    <div class="wrap grid-2">
      <div class="prose">
        <h2>Who we are</h2>
        <p>
          Floyd Homes and Land sells homes and land across Southeastern Virginia, Northeastern North Carolina
          and the Outer Banks. Our sales are powered by {site.brokerage.name}, and we specialize in land
          development and investment ourselves.
        </p>
        <p><a class="text-link" href="/who-we-are/">Read Dustin's story</a></p>
      </div>
      <div class="prose">
        <h2>What to do next</h2>
        <ul class="ledger">
          <li><a class="ledger-link" href="/what-we-do/sell-direct/#form"><span class="ledger-num">01</span><span class="ledger-title">Tell us about your property</span><span class="ledger-arrow" aria-hidden="true">→</span><span class="ledger-desc">The sell-direct form goes straight to Dustin.</span></a></li>
          <li><a class="ledger-link" href={`tel:${site.phone.tel}`}><span class="ledger-num">02</span><span class="ledger-title">Call or text {site.phone.display}</span><span class="ledger-arrow" aria-hidden="true">→</span><span class="ledger-desc">Talk to Dustin directly.</span></a></li>
          <li><a class="ledger-link" href={site.campaignSite}><span class="ledger-num">03</span><span class="ledger-title">Use the link on your letter</span><span class="ledger-arrow" aria-hidden="true">→</span><span class="ledger-desc">If your letter had a QR code, it opens the page written for that letter.</span></a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
