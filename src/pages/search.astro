---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---
<Base title="Search Listings" description="Search homes and land for sale in Southeastern Virginia, Northeastern North Carolina and the Outer Banks through Dustin Floyd's Howard Hanna site.">
  <PageHeader eyebrow="Search" title="Look up anything in SEVA, NENC and the OBX." lede="Listing search runs through Dustin's Howard Hanna site, so you see everything on the market, not just FHL listings.">
    <div class="btn-row">
      <a class="btn btn--primary" href={site.agentSite} rel="noopener">Search on dustinfloyd.howardhanna.com</a>
      <a class="btn btn--ghost" href="/start/buy-sell/">Have Dustin search for you</a>
    </div>
  </PageHeader>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Markets</h2>
      <ul class="ledger">
        {site.markets.map((m) => (
          <li><a class="ledger-link" href={site.agentSite} rel="noopener">
            <span class="ledger-num">{m.short}</span>
            <span class="ledger-title">{m.name}</span>
            <span class="ledger-arrow" aria-hidden="true">→</span>
          </a></li>
        ))}
      </ul>
      <!-- When Dustin's IDX feed is approved, the embedded search replaces the links above. -->
      <p class="muted small idx-note">Search opens Dustin Floyd's site with {site.brokerage.name}.</p>
    </div>
  </section>
</Base>
<style> .idx-note { margin-top: 20px; } </style>
