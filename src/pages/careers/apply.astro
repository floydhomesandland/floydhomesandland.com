---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import IntakeForm from '../../components/IntakeForm.astro';
import Field from '../../components/Field.astro';
import Choices from '../../components/Choices.astro';
---
<Base title="Work at FHL" description="Tell Floyd Homes and Land about yourself and what you'd want to build here.">
  <PageHeader eyebrow="Careers" title="Tell us about yourself." lede="No resume required to start. Tell us who you are and what you'd want to do." plat={false} />
  <section class="section">
    <div class="wrap wrap--narrow">
      <IntakeForm formKey="careers" title="About you" submitLabel="Send to Dustin" consentTopic="working at Floyd Homes and Land">
        <Choices legend="Which sounds most like you?" name="role" options={['Licensed agent', 'College grad', 'I have an idea', 'I want a good job', 'Something else']} required detail="Applicant type" />
        <Field label="What do you do now?" name="current" detail="Currently" />
        <Field label="Link to your resume, LinkedIn or work" name="link" type="url" detail="Link" />
        <Field label="What would you want to build or do at FHL?" name="remarks" multiline required error="Tell us a little about what you'd want to do." />
      </IntakeForm>
    </div>
  </section>
</Base>
