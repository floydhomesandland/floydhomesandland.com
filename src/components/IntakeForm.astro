---
// The shared intake form. Sends to the Airtable website-form automation and, on
// success, goes to /thanks/<formKey>/. Fields go in the default slot.
import Field from './Field.astro';
import Choices from './Choices.astro';
import { forms, site, type FormKey } from '../data/site';

interface Props {
  formKey: FormKey;
  title?: string;
  intro?: string;
  submitLabel?: string;
  contact?: 'full' | 'email';
  consentTopic?: string;
  card?: boolean;
}
const {
  formKey,
  title,
  intro,
  submitLabel = 'Send to Dustin',
  contact = 'full',
  consentTopic = 'my inquiry',
  card = true,
} = Astro.props;
const meta = forms[formKey];
---
<form
  class:list={['intake', { 'intake--card': card }]}
  data-fhl-form
  data-form={meta.form}
  data-page={formKey}
  data-thanks={`/thanks/${formKey}/`}
  data-webhook={site.formWebhook}
  data-phone={site.phone.display}
  novalidate
>
  {title && <h2 class="intake-title">{title}</h2>}
  {intro && <p class="muted">{intro}</p>}

  <slot />

  {contact === 'full' ? (
    <fieldset class="group">
      <legend class="group-legend">How to reach you</legend>
      <Field label="Your name" name="name" required autocomplete="name" error="Enter your name." />
      <Field label="Phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" error="Enter a phone number Dustin can reach you at." />
      <Field label="Email" name="email" type="email" autocomplete="email" inputmode="email" error="Enter an email address like name@example.com." />
      <Choices legend="Best way to reach you" name="contact_method" options={['Call', 'Text', 'Email']} />
      <Choices legend="Best time" name="contact_time" options={['Morning (8am–12pm)', 'Afternoon (12pm–5pm)', 'Evening (5pm–8pm)', 'Anytime']} />
    </fieldset>
  ) : (
    <div class="group">
      <Field label="Your name" name="name" required autocomplete="name" error="Enter your name." />
      <Field label="Email" name="email" type="email" required autocomplete="email" inputmode="email" error="Enter an email address like name@example.com." />
    </div>
  )}

  <div class="hp" aria-hidden="true">
    <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="field consent">
    <label class="consent-label">
      <input type="checkbox" name="consent" value="true" required data-error="Check the box so Dustin is allowed to contact you." aria-describedby={`${formKey}-consent-err`} />
      <span>
        I agree that Dustin Floyd of {site.legalName} may contact me about {consentTopic} by phone call, text
        message or email at the contact details above. Message and data rates may apply.
        See our <a href="/privacy/">privacy policy</a> and <a href="/terms/">terms</a>.
      </span>
    </label>
    <p class="err" id={`${formKey}-consent-err`} hidden></p>
    <span class="todo">[[TODO: Dustin to approve consent wording for this form]]</span>
  </div>

  <button type="submit" class="btn btn--primary submit">{submitLabel}</button>
  <p class="status" role="alert" hidden></p>
  <p class="small muted after">
    Rather talk? Call or text Dustin at <span class="phone-plain">{site.phone.display}</span>.
  </p>
</form>

<script>
  import { initForms } from '../scripts/forms';
  initForms();
</script>

<style is:global>
  .intake { display: grid; gap: 22px; }
  .intake--card {
    background: var(--surface); border-radius: var(--radius-md); border-top: 4px solid var(--gold);
    box-shadow: var(--shadow-card); padding: 24px 20px;
  }
  @media (min-width: 560px) { .intake--card { padding: 32px; } }
  .intake-title { font-size: 1.6rem; margin: 0; }
  .intake .group { border: 0; padding: 0; margin: 0; display: grid; gap: 18px; min-width: 0; }
  .intake .group-legend {
    font-family: var(--font-label); font-weight: 600; font-size: 0.74rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--green); padding: 0; margin-bottom: 4px;
  }
  .field { display: grid; gap: 8px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .field > label, .field > legend { font-weight: 600; font-size: 1rem; line-height: 1.3; padding: 0; }
  .field .opt { font-weight: 400; color: var(--muted); }
  .field .hint { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .field input[type='text'], .field input[type='tel'], .field input[type='email'], .field input[type='url'], .field input:not([type]), .field textarea {
    width: 100%; min-height: 48px; padding: 12px 14px; font: inherit; font-size: 1rem; color: var(--ink);
    background: var(--surface); border: 1.5px solid var(--field-border); border-radius: var(--radius-sm);
  }
  .field textarea { min-height: 120px; resize: vertical; }
  .field input:focus, .field textarea:focus { outline: 3px solid var(--gold-ink); outline-offset: 1px; box-shadow: 0 0 0 6px var(--green-tint); }
  .field [aria-invalid='true'], .choices[aria-invalid='true'] .chip span { border-color: var(--error); }
  .err { margin: 0; color: var(--error); font-size: 0.92rem; font-weight: 600; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px;
    border: 1.5px solid var(--field-border); border-radius: var(--radius-sm); background: var(--surface);
    font-size: 0.98rem; cursor: pointer;
  }
  .chip input:checked + span { background: var(--green-deep); border-color: var(--green-deep); color: var(--on-dark); }
  .chip input:focus-visible + span { outline: 3px solid var(--gold-ink); outline-offset: 2px; }
  .consent-label { display: grid; grid-template-columns: 24px 1fr; gap: 12px; font-weight: 400 !important; font-size: 0.9rem !important; line-height: 1.45 !important; color: var(--muted); }
  .consent-label input { width: 22px; height: 22px; margin: 1px 0 0; accent-color: var(--green-deep); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .submit { width: 100%; }
  @media (min-width: 560px) { .submit { width: auto; justify-self: start; } }
  .status { margin: 0; padding: 12px 14px; border-radius: var(--radius-sm); background: #fbecea; color: var(--error); font-weight: 600; }
  .after { margin: 0; }
</style>
