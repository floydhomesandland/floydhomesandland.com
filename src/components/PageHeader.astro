---
// Page title block: eyebrow, h1, lede, optional actions. `plat` adds the decorative
// survey drawing on wide screens.
import Plat from './Plat.astro';
interface Props { eyebrow?: string; title: string; lede?: string; plat?: boolean }
const { eyebrow, title, lede, plat = true } = Astro.props;
---
<section class="page-header">
  <div class="wrap ph-grid">
    <div class="ph-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {plat && <Plat class="ph-plat" />}
  </div>
</section>

<style>
  .page-header { padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px); border-bottom: 1px solid var(--line); overflow: hidden; }
  .ph-grid { display: grid; gap: 40px; align-items: center; }
  .ph-text h1 { max-width: 16ch; }
  :global(.ph-plat) { display: none; }
  @media (min-width: 920px) {
    .ph-grid { grid-template-columns: 1.5fr 1fr; }
    :global(.ph-plat) { display: block; max-width: 380px; justify-self: end; }
  }
</style>
